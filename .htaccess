# ============================================================
# F1 TAXI — site-wide security headers
# These complement the Content-Security-Policy <meta> tag in each
# page (the CSP is in the HTML so it applies even when Plesk's nginx
# serves the static file directly and skips Apache/.htaccess).
#
# Everything is wrapped in <IfModule> so a host without mod_headers
# simply ignores it — this file can never take the site down.
# If the server already has a root .htaccess (e.g. an HTTPS redirect),
# merge these lines into it rather than overwriting.
# ============================================================

<IfModule mod_headers.c>
  # Clickjacking: don't allow the site to be embedded in a frame elsewhere.
  Header always set X-Frame-Options "SAMEORIGIN"

  # Stop browsers from MIME-sniffing a response into a different type.
  Header always set X-Content-Type-Options "nosniff"

  # Only send the origin (not the full path) as the referrer cross-site.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Deny powerful browser features the site doesn't use.
  Header always set Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=()"
</IfModule>

# Don't list directory contents if there's no index file.
<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>

# ============================================================
# Browser caching (PageSpeed: "serve static assets with an efficient
# cache policy"). Media/fonts get a long cache; CSS/JS a shorter one
# since their filenames aren't versioned. HTML is never long-cached so
# content updates always show.
# ============================================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg          "access plus 1 year"
  ExpiresByType image/png           "access plus 1 year"
  ExpiresByType image/webp          "access plus 1 year"
  ExpiresByType image/avif          "access plus 1 year"
  ExpiresByType image/svg+xml       "access plus 1 year"
  ExpiresByType image/x-icon        "access plus 1 year"
  ExpiresByType video/mp4           "access plus 1 year"
  ExpiresByType font/woff2          "access plus 1 year"
  ExpiresByType text/css            "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/html           "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # Long, immutable cache for fingerprint-stable media & fonts.
  <FilesMatch "\.(jpg|jpeg|png|webp|avif|svg|ico|mp4|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Shorter cache for CSS/JS (filenames aren't versioned yet).
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
